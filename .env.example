# Kopiere diese Datei zu .env und passe die Werte an

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pkc_password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=pkc_chunks

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pkc
POSTGRES_USER=pkc_user
POSTGRES_PASSWORD=pkc_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Embedding Model (lokal)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cuda  # cuda oder cpu

# vLLM (Week 4)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# API
API_HOST=0.0.0.0
API_PORT=8080

# LLM (Gemma 4)
LLM_MODEL=google/gemma-4-E4B-it
LLM_MAX_TOKENS=8192
